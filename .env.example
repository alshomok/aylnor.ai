# ============================================
# AYLNOR.AI - Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your actual values
# For Vercel deployment, add these to your project settings

# ============================================
# GOOGLE GEMINI API KEYS
# ============================================
# Get your keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# ============================================
# X.AI GROK API KEYS
# ============================================
# Get your keys from: https://console.x.ai/
GROK_API_KEY_1=your_grok_api_key_1_here
GROK_API_KEY_2=your_grok_api_key_2_here

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get your credentials from: https://app.supabase.com/
# Make sure to use the PUBLIC keys for client-side access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# NEXTAUTH CONFIGURATION (Optional)
# ============================================
# For authentication setup (if needed)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Production URL for CORS and deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# NOTES FOR VERCEL DEPLOYMENT
# ============================================
# 1. DO NOT commit .env.local to git
# 2. Add these variables in Vercel Dashboard:
#    - Go to your project settings
#    - Navigate to "Environment Variables"
#    - Add each variable with its value
# 3. Variables starting with NEXT_PUBLIC_ are exposed to browser
# 4. Other variables are only available on the server
# 5. After adding variables, redeploy your project
